# ── Site ─────────────────────────────────────────────────────────────
# Public production URL (no trailing slash). On Vercel the production domain is used when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Private admin panel ──────────────────────────────────────────────
# The ONLY host(s) where /admin works, comma-separated. Everywhere else /admin is a 404.
# Example: add the domain "zenox-admin.vercel.app" to the same Vercel project and put it here.
ADMIN_HOST=zenox-admin.vercel.app
# Password for the panel. Use a long random one.
ADMIN_PASSWORD=
# Optional: separate secret for signing sessions (defaults to one derived from ADMIN_PASSWORD).
# Changing it logs out every session.
ADMIN_SECRET=

# ── Where contact requests are stored (required in production) ───────
# Connect "Upstash for Redis" from the Vercel Marketplace and these are added for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.)

# ── Optional: also email every request to you (Resend) ───────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
