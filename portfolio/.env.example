# Public production URL (no trailing slash). Used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form email delivery via Resend (https://resend.com). Server-side only — never commit real values.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend. Defaults to Resend's test sender if omitted.
CONTACT_FROM_EMAIL=
